# Server-only. Never prefix with VITE_ — that inlines the value into the JS bundle.
# When set, Cloudflare/Vite prompt with HTTP Basic auth (username can be anything).
# Leave empty to make the dashboard public.
# Local Vite: this file. Cloudflare: wrangler pages secret put DASHBOARD_PASSWORD
DASHBOARD_PASSWORD=

# Optional. When provided, the map can use Mapbox styles instead of the free basemap.
# VITE_MAPBOX_TOKEN=pk.eyJ...
# VITE_MAP_STYLE=mapbox://styles/mapbox/light-v11
